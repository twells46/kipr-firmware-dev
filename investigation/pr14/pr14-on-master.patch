diff -ruN a/Firmware/src/wallaby_init.c b/Firmware/src/wallaby_init.c
--- a/Firmware/src/wallaby_init.c	2026-10-19 09:34:55.000000000 -0500
+++ b/Firmware/src/wallaby_init.c	2026-10-27 09:31:16.992877803 -0500
@@ -37,6 +37,24 @@
 
 void init()
 {
+    // PE10 drives the enable of the 6 V servo regulator (U72), which R52 pulls up
+    // to the battery, so it is open-drain: low turns servo power off, released
+    // turns it on. Servos start disabled, so power starts off. The rail is on
+    // from reset until this runs, so it comes before init180MHz() waits on the
+    // crystal.
+    RCC_AHB1PeriphClockCmd(RCC_AHB1Periph_GPIOE, ENABLE);
+    {
+        SRV_DISABLE_PORT->BSRRH |= SRV_DISABLE;
+
+        GPIO_InitTypeDef GPIO_InitStructure;
+        GPIO_InitStructure.GPIO_Pin = SRV_DISABLE;
+        GPIO_InitStructure.GPIO_Mode = GPIO_Mode_OUT;
+        GPIO_InitStructure.GPIO_OType = GPIO_OType_OD;
+        GPIO_InitStructure.GPIO_PuPd = GPIO_PuPd_NOPULL;
+        GPIO_InitStructure.GPIO_Speed = GPIO_Speed_2MHz;
+        GPIO_Init(SRV_DISABLE_PORT, &GPIO_InitStructure);
+    }
+
     init180MHz(); // switch over to 180 MHz via the external 24 MHz crystal and a PLL
 
     initSystick(); // get a wallclock started, ticking at 1ms
diff -ruN a/Firmware/src/wallaby_servo.c b/Firmware/src/wallaby_servo.c
--- a/Firmware/src/wallaby_servo.c	2026-10-19 09:34:55.000000000 -0500
+++ b/Firmware/src/wallaby_servo.c	2026-10-27 09:31:16.992945058 -0500
@@ -125,3 +125,35 @@
         TIM_SetCompare2(TIM9, servo2_cmd);
     }
 }
+
+void update_servo_power(void)
+{
+    // Digital servos hold position with no pulses and only go limp without power.
+    // One regulator (U72) feeds all four ports, so power can only be cut once
+    // every servo is disabled.
+    static uint8_t all_disabled = 0;
+    static uint32_t all_disabled_since;
+
+    if ((aTxBuffer[REG_RW_MOT_SRV_ALLSTOP] & 0b11110000) == 0b11110000)
+    {
+        if (!all_disabled)
+        {
+            all_disabled = 1;
+            all_disabled_since = usCount;
+        }
+
+        // The timer ISRs zero a port's pulse at its next 20 ms update, and compare
+        // preload applies that one period later, so pulses can continue for up to
+        // 40 ms. Cutting power before then would drive the last pulses into an
+        // unpowered servo.
+        if (usCount - all_disabled_since >= 40000)
+        {
+            SRV_DISABLE_PORT->BSRRH |= SRV_DISABLE; // power off
+        }
+    }
+    else
+    {
+        all_disabled = 0;
+        SRV_DISABLE_PORT->BSRRL |= SRV_DISABLE; // released, power on
+    }
+}
