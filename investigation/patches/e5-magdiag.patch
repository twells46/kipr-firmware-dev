+/*
+ * E5 magdiag (investigation only). Published in the magnetometer slots:
+ *   22 marker 0xD7, 23 item, 24 value, 25 seq, 26 ~value, 27 checksum
+ *   checksum = 0x2B + 7*item + 13*value + 31*seq (mod 256)
+ * Items: 0-2 ASA bytes as setup_magnetometer() read them; 3 AK8963 WIA,
+ * 4 CNTL1 as setup_magnetometer() left it, 5-7 ASA read properly (Fuse ROM
+ * mode, waiting for each I2C transaction), 8 CNTL1 after the proper
+ * sequence, 9 latest ST2 from readIMU(), 10 number of readIMU() reads with
+ * ST2.HOFL (overflow) set, mod 256.
+ */
+enum { MD_ASA_OLD = 0, MD_WIA = 3, MD_CNTL_OLD = 4, MD_ASA_NEW = 5, MD_CNTL_NEW = 8, MD_ST2 = 9, MD_HOFL = 10, MD_N = 11 };
+static uint8_t magdiag[MD_N];
+static uint8_t magdiag_item, magdiag_seq;
+
+// One AK8963 register write through SLV0, waiting for the MPU's I2C master
+// (which runs once per sample, 5 ms at 200 Hz) to perform it.
+static void ak_write_wait(uint8_t reg, uint8_t val)
+{
+    IMU_write(I2C_SLV0_ADDR, AK8963_PHYSICAL_LOCAT);
+    IMU_write(I2C_SLV0_REG, reg);
+    IMU_write(I2C_SLV0_DO, val);
+    IMU_write(I2C_SLV0_CTRL, READ_FLAG | 1);
+    delay_us(20000);
+    IMU_write(I2C_SLV0_CTRL, 0);
+    delay_us(10000);
+}
+
+static void ak_read_wait(uint8_t reg, uint8_t n, uint8_t *out)
+{
+    IMU_write(I2C_SLV0_ADDR, AK8963_PHYSICAL_LOCAT | READ_FLAG);
+    IMU_write(I2C_SLV0_REG, reg);
+    IMU_write(I2C_SLV0_CTRL, READ_FLAG | n);
+    delay_us(20000);
+    read_bytes(EXT_SENS_DATA_00, n, out);
+    IMU_write(I2C_SLV0_CTRL, 0);
+    delay_us(10000);
+}
+
+static void magdiag_setup(void)
+{
+    uint8_t b[3];
+    ak_read_wait(AK8963_WHO_AM_I, 1, b);
+    magdiag[MD_WIA] = b[0];
+    ak_read_wait(AK8963_CNTL, 1, b);
+    magdiag[MD_CNTL_OLD] = b[0];
+    ak_write_wait(AK8963_CNTL, 0x00);
+    ak_write_wait(AK8963_CNTL, 0x0F);
+    ak_read_wait(AK8963_ASAX, 3, b);
+    for (uint8_t i = 0; i < 3; ++i) magdiag[MD_ASA_NEW + i] = b[i];
+    ak_write_wait(AK8963_CNTL, 0x00);
+    ak_write_wait(AK8963_CNTL, MAGNETOMETER_CONFIG_BYTE);
+    ak_read_wait(AK8963_CNTL, 1, b);
+    magdiag[MD_CNTL_NEW] = b[0];
+}
+
