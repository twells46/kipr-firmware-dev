diff -ru a/Firmware/src/wallaby_dma.c b/Firmware/src/wallaby_dma.c
--- a/Firmware/src/wallaby_dma.c	2026-10-12 15:07:19.497171426 -0500
+++ b/Firmware/src/wallaby_dma.c	2026-10-12 15:07:28.233211922 -0500
@@ -155,8 +155,32 @@
 // transfer of the wrong length, or a glitch on SCK or chip select, every later
 // frame is offset until SPI2 and both streams are reset. Called once per main
 // loop pass.
+volatile uint16_t d13[D13_N];
+static void d13_inc(uint8_t i) { if (d13[i] != 0xFFFF) d13[i]++; }
+static void d13_max(uint8_t i, uint32_t cyc) { uint32_t v = cyc / 18; if (v > 0xFFFF) v = 0xFFFF; if (v > d13[i]) d13[i] = v; } /* 0.1 us at 180 MHz */
+
+/* One item per main-loop pass in the magnetometer slots:
+ * 22 marker 0xD3, 23 item, 24 value_h, 25 value_l, 26 ~item,
+ * 27 checksum = 0x5A + 13*item + 31*value_h + 3*value_l */
+void d13_publish(uint32_t sensor_update_time)
+{
+    static uint8_t item;
+    if (sensor_update_time > d13[D13_SENS_MAX]) d13[D13_SENS_MAX] = sensor_update_time > 0xFFFF ? 0xFFFF : sensor_update_time;
+    if (sensor_update_time >= 700) d13_inc(D13_OVER700);
+    d13[D13_PASSES]++;
+    uint8_t i = item, h = d13[i] >> 8, l = d13[i] & 0xFF;
+    item = (item + 1) % D13_N;
+    aTxBuffer[REG_RW_MAG_X_H] = 0xD3;
+    aTxBuffer[REG_RW_MAG_X_L] = i;
+    aTxBuffer[REG_RW_MAG_Y_H] = h;
+    aTxBuffer[REG_RW_MAG_Y_L] = l;
+    aTxBuffer[REG_RW_MAG_Z_H] = (uint8_t)~i;
+    aTxBuffer[REG_RW_MAG_Z_L] = (uint8_t)(0x5A + 13 * i + 31 * h + 3 * l);
+}
+
 void spi2_dma_check_sync()
 {
+    uint32_t d_c0 = DWT->CYCCNT;
     // Between transfers, an aligned RX stream has just reloaded its count to a
     // full frame, so any other count means the last transfer had the wrong
     // length. The last byte can still be on its way to memory just after chip
@@ -166,13 +190,16 @@
     if (spi2_cs_high() && DMA_GetCurrDataCounter(DMA1_Stream3) != BUFFERSIZE)
     {
         delay_us(2);
-        if (spi2_cs_high() && DMA_GetCurrDataCounter(DMA1_Stream3) != BUFFERSIZE) spi_resync = 1;
+        uint16_t d_ndtr = DMA_GetCurrDataCounter(DMA1_Stream3);
+        if (spi2_cs_high() && DMA_GetCurrDataCounter(DMA1_Stream3) != BUFFERSIZE) { spi_resync = 1; d13_inc(D13_COUNT); d13[D13_NDTR_LAST] = d_ndtr; }
+        else d13_inc(D13_INFLIGHT);
     }
 
     // An overrun stops reception until SPI2 is reset.
-    if (SPI_I2S_GetFlagStatus(SPI2, SPI_I2S_FLAG_OVR) != RESET) spi_resync = 1;
+    if (SPI_I2S_GetFlagStatus(SPI2, SPI_I2S_FLAG_OVR) != RESET) { spi_resync = 1; d13_inc(D13_OVR); }
 
-    if (!spi_resync) return;
+    if (!spi_resync) { d13_max(D13_CHECK_MAX, DWT->CYCCNT - d_c0); return; }
+    d13_inc(D13_ATTEMPT);
 
     // A transfer lasts about 45 us, so wait one out rather than retrying a whole
     // main-loop pass later, which can leave the link down for milliseconds
@@ -184,6 +211,8 @@
     // registers can't be rewritten until it has actually stopped. Interrupts
     // stay off so handle_dma() can't run against a half-reset link.
     __disable_irq();
+    uint32_t d_c1 = DWT->CYCCNT;
+    if (!spi2_cs_high()) d13_inc(D13_CSLOW);
     if (spi2_cs_high())
     {
         DMA_Cmd(DMA1_Stream4, DISABLE);
@@ -203,9 +232,14 @@
             // If the host started a transfer during the reset, SPI2 caught only
             // its tail, so reset again once that transfer ends.
             spi_resync = !spi2_cs_high();
+            d13_inc(D13_RESET);
+            if (spi_resync) d13_inc(D13_RETRY);
         }
+        else d13_inc(D13_TRIES);
     }
+    d13_max(D13_IRQOFF_MAX, DWT->CYCCNT - d_c1);
     __enable_irq();
+    d13_max(D13_CHECK_MAX, DWT->CYCCNT - d_c0);
 }
 
 
@@ -371,7 +405,7 @@
             // A wrong start or end byte means the DMA has lost the frame
             // boundary. A wrong version alone is a protocol mismatch, which a
             // reset can't fix.
-            if (!framed) spi_resync = 1;
+            if (!framed) { spi_resync = 1; if (d13[D13_FRAME] != 0xFFFF) d13[D13_FRAME]++; }
         }
         // Clear DMA Transfer Complete Flags so we can notice when a transfer happens again
         DMA_ClearFlag(DMA1_Stream4,DMA_FLAG_TCIF4); // tx
